# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template

START hilow_game

    OUTPUT "Enter a lower bound:"
    INPUT lowerBound

    OUTPUT "Enter an upper bound:"
    INPUT upperBound

    WHILE lowerBound >= upperBound
        OUTPUT "Invalid range. Lower bound must be less than upper bound."

        OUTPUT "Enter a lower bound:"
        INPUT lowerBound

        OUTPUT "Enter an upper bound:"
        INPUT upperBound
    END WHILE

    SET targetNumber = random number between lowerBound and upperBound

    OUTPUT "Enter a guess between lowerBound and upperBound:"
    INPUT guess

    WHILE guess < lowerBound OR guess > upperBound
        OUTPUT "Invalid guess. Enter a number within the range."
        INPUT guess
    END WHILE

    WHILE guess != targetNumber

        IF guess < targetNumber THEN
            OUTPUT "Too low."
        ELSE
            OUTPUT "Too high."
        END IF

        OUTPUT "Enter a guess between lowerBound and upperBound:"
        INPUT guess

        WHILE guess < lowerBound OR guess > upperBound
            OUTPUT "Invalid guess. Enter a number within the range."
            INPUT guess
        END WHILE

    END WHILE

    OUTPUT "Correct! You guessed the number."

END hilow_game
